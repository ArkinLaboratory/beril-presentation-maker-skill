# Per-draft runtime state (created in BERIL projects, never in this repo)
talks/draft_*/state.json
talks/draft_*/audit/
talks/cost-log.jsonl

# Generated derivatives of the master template (we ship the source .pptx,
# not the rendered drafts)
*.bak.pptx

# Source .potx — user-supplied, never redistributed.
# See reference/master-template-source-notes.md §1.
reference/master-template-source/*.potx
reference/master-template-source/*.pptx

# Commit-message scratchpads — staging input for `git commit -F`.
# Kept local; the message itself lives in `git log` once committed.
.commit-message*.txt
